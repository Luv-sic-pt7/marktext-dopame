{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@dopame/acde-api"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@muyajs/core": ["../muya/lib/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
